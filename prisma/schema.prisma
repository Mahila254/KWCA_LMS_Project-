generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  ADMIN
  STUDENT
}

enum Gender {
  MALE
  FEMALE
  PREFER_NOT_TO_SAY
}

enum CourseStatus {
  DRAFT
  PUBLISHED
}

enum CourseAccessType {
  FREE_PREVIEW
  PREMIUM
  SUBSCRIPTION_ONLY
}

enum LessonAccessType {
  PREVIEW
  PREMIUM
}

enum PaymentType {
  PAY_PER_COURSE
  MONTHLY_SUBSCRIPTION
  ANNUAL_SUBSCRIPTION
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

enum QuizType {
  PRACTICE
  FINAL
}

enum VideoQuestionType {
  TRUE_FALSE
  MULTIPLE_CHOICE
}

// Failed admin login counts, see lib/loginThrottle.ts. Keys are hashed.
model AdminLoginAttempt {
  key         String   @id
  failures    Int      @default(0)
  windowStart DateTime @default(now())
}

model User {
  id           String    @id @default(cuid())
  name         String?
  email        String    @unique
  gender       Gender?
  role         UserRole  @default(STUDENT)
  consentGiven Boolean   @default(false)
  consentedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  enrollments  Enrollment[]
  quizResults  QuizResult[]
  certificates Certificate[]
  payments     Payment[]
  feedback     CourseFeedback[]
}

model Course {
  id               String           @id @default(cuid())
  title            String
  slug             String           @unique
  description      String?
  category         String?
  imageUrl         String?
  introVideoUrl    String?
  learningOutcomes String?
  numberOfLessons  Int              @default(0)
  status           CourseStatus     @default(DRAFT)
  accessType       CourseAccessType @default(FREE_PREVIEW)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  lessons       Lesson[]
  enrollments   Enrollment[]
  quizResults   QuizResult[]
  certificates  Certificate[]
  payments      Payment[]
  quizQuestions QuizQuestion[]
  feedback      CourseFeedback[]
}

model Lesson {
  id         String           @id @default(cuid())
  courseId   String
  title      String
  slug       String
  content    String?
  videoUrl   String?
  readingUrl String?
  notes      String?
  order      Int
  accessType LessonAccessType @default(PREVIEW)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  course         Course                @relation(fields: [courseId], references: [id], onDelete: Cascade)
  videoQuestions LessonVideoQuestion[]

  @@unique([courseId, slug])
}

// A question that pops up part-way through a lesson video: the video
// pauses at timeSeconds, the learner answers, sees the answer, and carries
// on. Not marked or recorded. See lib/videoQuestions.ts.
model LessonVideoQuestion {
  id           String            @id @default(cuid())
  lessonId     String
  timeSeconds  Int
  type         VideoQuestionType @default(TRUE_FALSE)
  question     String
  options      String[]
  correctIndex Int
  explanation  String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId])
}

model QuizQuestion {
  id            String   @id @default(cuid())
  courseId      String
  quizType      QuizType
  question      String
  optionA       String
  optionB       String
  optionC       String
  optionD       String
  correctAnswer String
  explanation   String?
  order         Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model Enrollment {
  id        String   @id @default(cuid())
  userId    String
  courseId  String
  progress  Int      @default(0)
  completed Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

model QuizResult {
  id         String   @id @default(cuid())
  userId     String
  courseId   String
  quizType   String
  score      Int
  passed     Boolean  @default(false)
  // Snapshot of every question in the attempt (text, options, the
  // learner's pick, the correct answer) so it can be reviewed later even
  // if the admin edits the questions. Hidden by default in lib/prisma.ts;
  // only the review route reads it, and only for PRACTICE attempts.
  answers    Json?
  createdAt  DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model Certificate {
  id              String   @id @default(cuid())
  userId          String
  courseId        String
  certificateCode String   @unique
  issuedAt        DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

model Payment {
  id          String        @id @default(cuid())
  userId      String
  courseId    String?
  paymentType PaymentType
  amount      Int
  currency    String        @default("KES")
  status      PaymentStatus @default(PENDING)
  provider    String        @default("PAYSTACK")
  providerRef String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)
}

model CourseFeedback {
  id        String   @id @default(cuid())
  userId    String
  courseId  String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}
